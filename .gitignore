cat >> .gitignore <<'EOF'

# Python virtual environments
.venv/
.venv-cpu/
venv/
venv-cpu/
venv-cpu.backup.*/
**/.venv*/
**/venv*/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Training outputs
*.pt
*.pth
*.ckpt
results/checkpoints/*
!results/checkpoints/.gitkeep
EOF
# Include experiment CSVs in version control
!/results/**/*.csv
